#!/usr/bin/env python3
"""voxtype-presets-edit — voxtype-configure-style TUI preset editor.

Launched from the Omarchy bar popup (a / e keys) through
`omarchy-launch-floating-terminal-with-presentation`, the same floating
terminal wrapper the built-in Dictation indicator uses for `voxtype configure`.

Keys:
  ←/→  Tab / Shift+Tab    switch tab (Model / Language / Keywords / Output)
  j/k  ↑/↓                move between items
  Enter / Space           select item / start editing / toggle checkbox
  s / Ctrl+S              save preset (re-applies when it is the active preset)
  q / Esc                 quit without saving
"""

import curses
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from voxtype_presets_lib import load, save, theme_colors  # noqa: E402

MODELS = [
    "base.en", "base", "small.en", "small", "medium.en", "medium",
    "large-v3", "large-v3-turbo",
    "parakeet-tdt-0.6b-v3", "parakeet-tdt-0.6b-v3-int8",
]
LANGS = ["auto", "en", "is", "fr", "de", "es", "pt", "it", "nl", "sv",
         "da", "no", "fi", "pl", "ru", "uk", "ja", "zh", "ko", "ar", "hi"]
TABS = ["Model", "Language", "Keywords", "Output"]
CUSTOM = "custom…"
HINTS = "←/→ tab · j/k move · Enter select · s save · q quit"


def hex_rgb(hex_color):
    hex_color = hex_color.lstrip("#")
    if len(hex_color) == 3:
        hex_color = "".join(c * 2 for c in hex_color)
    try:
        return tuple(int(hex_color[i:i + 2], 16) for i in (0, 2, 4))
    except ValueError:
        return (169, 177, 214)


def setup_colors(colors):
    """Define curses colors from the Omarchy theme; degrade gracefully."""
    try:
        curses.start_color()
        curses.use_default_colors()
    except curses.error:
        return {"fg": 0, "accent": 0, "muted": 0, "sel": 0}

    def define(idx, hex_color):
        r, g, b = hex_rgb(hex_color)
        try:
            curses.init_color(idx, int(r * 1000 / 255),
                              int(g * 1000 / 255), int(b * 1000 / 255))
        except curses.error:
            pass

    define(1, colors["background"])
    define(2, colors["foreground"])
    define(3, colors["accent"])
    define(4, colors["muted"])

    pairs = {}
    try:
        curses.init_pair(1, 2, 1)
        curses.init_pair(2, 3, 1)
        curses.init_pair(3, 4, 1)
        curses.init_pair(4, 1, 3)
        pairs = {
            "fg": curses.color_pair(1),
            "accent": curses.color_pair(2),
            "muted": curses.color_pair(3),
            "sel": curses.color_pair(4),
        }
    except curses.error:
        pass
    return pairs


class Editor:
    def __init__(self, stdscr, name, preset, pairs):
        self.stdscr = stdscr
        self.pairs = pairs
        self.name = name
        self.model = str(preset.get("model", "base.en")) if preset else "base.en"
        self.language = str(preset.get("language", "auto")) if preset else "auto"
        self.copy_to_clipboard = bool(preset.get("copyToClipboard", True)) if preset else True
        self.pause_media = bool(preset.get("pauseMedia", True)) if preset else True
        keywords = str(preset.get("keywords", "")) if preset else ""
        self.keywords_lines = keywords.split("\n") if keywords else [""]
        self.model_custom = self.model if self.model not in MODELS else ""
        self.lang_custom = self.language if self.language not in LANGS else ""
        self.tab = 0
        self.model_idx = self._index_of(MODELS, self.model)
        self.lang_idx = self._index_of(LANGS, self.language)
        self.out_idx = 0
        self.editing_keywords = False
        self.kw_cx = 0
        self.kw_cy = 0
        self.message = ""

    def _index_of(self, items, value):
        try:
            return items.index(value)
        except ValueError:
            return len(items)  # the custom row

    def pair(self, name):
        return self.pairs.get(name, 0)

    # --- main loop ----------------------------------------------------------

    def run(self):
        while True:
            self.draw()
            ch = self.stdscr.getch()
            if self.editing_keywords:
                if not self.keywords_key(ch):
                    self.editing_keywords = False
                continue
            if not self.top_key(ch):
                return

    def top_key(self, ch):
        if ch in (ord("q"), ord("Q"), 27):  # q or Esc
            return False
        if ch in (ord("s"), ord("S"), 19):  # s or Ctrl+S
            self.do_save()
            return True
        if ch in (curses.KEY_LEFT, ord("h"), ord("H"), 353):  # ← or h or Shift+Tab
            self.tab = (self.tab - 1) % len(TABS)
            self.message = ""
            return True
        if ch in (curses.KEY_RIGHT, ord("l"), ord("L"), 9):  # → or l or Tab
            self.tab = (self.tab + 1) % len(TABS)
            self.message = ""
            return True
        if ch in (curses.KEY_DOWN, ord("j"), ord("J")):
            self.move_item(1)
            return True
        if ch in (curses.KEY_UP, ord("k"), ord("K")):
            self.move_item(-1)
            return True
        if ch in (10, 13, curses.KEY_ENTER, 32):  # Enter or Space
            self.activate_item()
            return True
        return True

    def move_item(self, delta):
        if self.tab == 0:
            self.model_idx = max(0, min(len(MODELS), self.model_idx + delta))
        elif self.tab == 1:
            self.lang_idx = max(0, min(len(LANGS), self.lang_idx + delta))
        elif self.tab == 3:
            self.out_idx = max(0, min(1, self.out_idx + delta))

    def activate_item(self):
        if self.tab == 0:
            if self.model_idx == len(MODELS):
                ok, value = self.input_line("Model", self.model_custom)
                if ok and value:
                    self.model_custom = value
                    self.model = value
            else:
                self.model = MODELS[self.model_idx]
                self.model_custom = ""
        elif self.tab == 1:
            if self.lang_idx == len(LANGS):
                ok, value = self.input_line("Language", self.lang_custom)
                if ok and value:
                    self.lang_custom = value
                    self.language = value
            else:
                self.language = LANGS[self.lang_idx]
                self.lang_custom = ""
        elif self.tab == 2:
            self.editing_keywords = True
            self.kw_cx = 0
            self.kw_cy = 0
            self.message = "editing keywords — Esc done · Ctrl+S save"
        elif self.tab == 3:
            if self.out_idx == 0:
                self.copy_to_clipboard = not self.copy_to_clipboard
            else:
                self.pause_media = not self.pause_media
        self.message = ""

    # --- keywords mini editor ----------------------------------------------

    def keywords_key(self, ch):
        lines = self.keywords_lines
        if ch == 27:  # Esc finishes editing
            return False
        if ch in (19,):  # Ctrl+S saves while editing
            self.do_save()
            return True
        if ch in (10, 13, curses.KEY_ENTER):
            line = lines[self.kw_cy]
            lines[self.kw_cy] = line[:self.kw_cx]
            lines.insert(self.kw_cy + 1, line[self.kw_cx:])
            self.kw_cy += 1
            self.kw_cx = 0
            return True
        if ch in (curses.KEY_BACKSPACE, 127, 8):
            if self.kw_cx > 0:
                line = lines[self.kw_cy]
                lines[self.kw_cy] = line[:self.kw_cx - 1] + line[self.kw_cx:]
                self.kw_cx -= 1
            elif self.kw_cy > 0:
                joined = lines[self.kw_cy - 1] + lines[self.kw_cy]
                lines.pop(self.kw_cy)
                self.kw_cy -= 1
                self.kw_cx = len(lines[self.kw_cy])
                lines[self.kw_cy] = joined
            return True
        if ch == curses.KEY_DC:
            line = lines[self.kw_cy]
            if self.kw_cx < len(line):
                lines[self.kw_cy] = line[:self.kw_cx] + line[self.kw_cx + 1:]
            elif self.kw_cy + 1 < len(lines):
                lines[self.kw_cy] += lines.pop(self.kw_cy + 1)
            return True
        if ch == curses.KEY_LEFT:
            self.kw_cx = max(0, self.kw_cx - 1)
            return True
        if ch == curses.KEY_RIGHT:
            self.kw_cx = min(len(lines[self.kw_cy]), self.kw_cx + 1)
            return True
        if ch == curses.KEY_UP:
            if self.kw_cy > 0:
                self.kw_cy -= 1
                self.kw_cx = min(self.kw_cx, len(lines[self.kw_cy]))
            return True
        if ch == curses.KEY_DOWN:
            if self.kw_cy + 1 < len(lines):
                self.kw_cy += 1
                self.kw_cx = min(self.kw_cx, len(lines[self.kw_cy]))
            return True
        if ch in (curses.KEY_HOME, 1):
            self.kw_cx = 0
            return True
        if ch == curses.KEY_END:
            self.kw_cx = len(lines[self.kw_cy])
            return True
        if ch == 23:  # Ctrl+W delete word
            line = lines[self.kw_cy]
            before = line[:self.kw_cx]
            stripped = before.rstrip()
            cut = len(stripped) - (len(stripped.split()[-1]) if stripped.split() else 0)
            lines[self.kw_cy] = line[:cut] + line[self.kw_cx:]
            self.kw_cx = cut
            return True
        if ch == 21:  # Ctrl+U clear to line start
            line = lines[self.kw_cy]
            lines[self.kw_cy] = line[self.kw_cx:]
            self.kw_cx = 0
            return True
        if 32 <= ch < 127:
            line = lines[self.kw_cy]
            lines[self.kw_cy] = line[:self.kw_cx] + chr(ch) + line[self.kw_cx:]
            self.kw_cx += 1
            return True
        return True

    # --- input prompt -------------------------------------------------------

    def input_line(self, prompt, initial):
        buf = list(initial)
        pos = len(buf)
        while True:
            self.message = f"{prompt}: {''.join(buf)}_"
            self.draw()
            ch = self.stdscr.getch()
            if ch in (10, 13):
                value = "".join(buf).strip()
                return bool(value), value
            if ch == 27:
                return False, initial
            if ch in (curses.KEY_BACKSPACE, 127, 8):
                if pos > 0:
                    buf.pop(pos - 1)
                    pos -= 1
            elif ch == curses.KEY_DC:
                if pos < len(buf):
                    buf.pop(pos)
            elif ch == curses.KEY_LEFT:
                pos = max(0, pos - 1)
            elif ch == curses.KEY_RIGHT:
                pos = min(len(buf), pos + 1)
            elif ch == 21:
                buf = buf[pos:]
                pos = 0
            elif 32 <= ch < 127:
                buf.insert(pos, chr(ch))
                pos += 1

    # --- saving ---------------------------------------------------------------

    def do_save(self):
        preset = {
            "name": self.name,
            "model": self.model,
            "language": self.language,
            "keywords": "\n".join(self.keywords_lines).strip(),
            "copyToClipboard": self.copy_to_clipboard,
            "pauseMedia": self.pause_media,
        }
        data = load()
        data["presets"] = [p for p in data["presets"] if p.get("name") != self.name]
        data["presets"].append(preset)
        save(data)
        if data.get("active") == self.name:
            subprocess.run(["omarchy-voxtype-presets", "apply", self.name], check=False)
            self.message = "saved + applied"
        else:
            self.message = "saved"

    # --- drawing ---------------------------------------------------------------

    def draw(self):
        std = self.stdscr
        std.erase()
        height, width = std.getmaxyx()
        height = max(height, 8)
        width = max(width, 40)

        title = f" Voxtype Preset Editor — {self.name} "
        try:
            std.addnstr(0, 0, title.ljust(width)[:width - 1], self.pair("sel"))
        except curses.error:
            pass

        # Tabs
        x = 2
        for i, label in enumerate(TABS):
            seg = f" {label} "
            pair = self.pair("sel") if i == self.tab else self.pair("muted")
            try:
                std.addnstr(1, x, seg, width - x - 1, pair)
            except curses.error:
                pass
            x += len(seg)

        # Content box
        top, bottom = 2, height - 3
        try:
            std.hline(top, 0, curses.ACS_HLINE, width - 1)
            std.hline(bottom, 0, curses.ACS_HLINE, width - 1)
            std.vline(top + 1, 0, curses.ACS_VLINE, bottom - top - 1)
            std.vline(top + 1, width - 2, curses.ACS_VLINE, bottom - top - 1)
            std.addch(top, 0, curses.ACS_ULCORNER)
            std.addch(top, width - 2, curses.ACS_URCORNER)
            std.addch(bottom, 0, curses.ACS_LLCORNER)
            std.addch(bottom, width - 2, curses.ACS_LRCORNER)
        except curses.error:
            pass

        inner_top, inner_bottom = top + 1, bottom - 1
        max_items = max(1, inner_bottom - inner_top + 1)

        if self.tab == 0:
            self.draw_model(max_items, inner_top, width)
        elif self.tab == 1:
            self.draw_language(max_items, inner_top, width)
        elif self.tab == 2:
            self.draw_keywords(max_items, inner_top, width)
        else:
            self.draw_output(inner_top, width)

        # Message + hints
        if self.message:
            try:
                std.addnstr(height - 2, 3, self.message[:width - 5], width - 5, self.pair("accent"))
            except curses.error:
                pass
        try:
            std.addnstr(height - 1, 3, HINTS[:width - 5], width - 5, self.pair("muted"))
        except curses.error:
            pass
        std.refresh()

    def draw_model(self, max_items, top, width):
        items = MODELS + [CUSTOM]
        offset = max(0, self.model_idx - max_items + 1)
        shown = items[offset:offset + max_items]
        for i, item in enumerate(shown):
            index = offset + i
            check = "✓" if (index < len(MODELS) and item == self.model) or \
                (index == len(MODELS) and self.model_custom) else " "
            if index == len(MODELS) and self.model_custom:
                item = f"{CUSTOM} ({self.model_custom})"
            cursor = ">" if index == self.model_idx else " "
            text = f" {cursor} [{check}] {item}"
            pair = self.pair("sel") if index == self.model_idx else self.pair("fg")
            try:
                self.stdscr.addnstr(top + i, 3, text, width - 6, pair)
            except curses.error:
                pass

    def draw_language(self, max_items, top, width):
        items = LANGS + [CUSTOM]
        offset = max(0, self.lang_idx - max_items + 1)
        shown = items[offset:offset + max_items]
        for i, item in enumerate(shown):
            index = offset + i
            check = "✓" if (index < len(LANGS) and item == self.language) or \
                (index == len(LANGS) and self.lang_custom) else " "
            if index == len(LANGS) and self.lang_custom:
                item = f"{CUSTOM} ({self.lang_custom})"
            cursor = ">" if index == self.lang_idx else " "
            text = f" {cursor} [{check}] {item}"
            pair = self.pair("sel") if index == self.lang_idx else self.pair("fg")
            try:
                self.stdscr.addnstr(top + i, 3, text, width - 6, pair)
            except curses.error:
                pass

    def draw_keywords(self, max_items, top, width):
        if self.editing_keywords:
            offset = max(0, self.kw_cy - max_items + 1)
            for i in range(min(max_items, len(self.keywords_lines) - offset)):
                line = self.keywords_lines[offset + i]
                y = top + i
                try:
                    self.stdscr.addnstr(y, 3, line[:width - 6], width - 6, self.pair("fg"))
                    if offset + i == self.kw_cy:
                        cx = min(self.kw_cx, width - 7)
                        ch = line[cx] if cx < len(line) else " "
                        self.stdscr.addstr(y, 3 + cx, ch, self.pair("sel"))
                except curses.error:
                    pass
        else:
            for i, line in enumerate(self.keywords_lines[:max_items - 1]):
                try:
                    self.stdscr.addnstr(top + i, 3, line[:width - 6], width - 6, self.pair("fg"))
                except curses.error:
                    pass
            if not self.keywords_lines or not self.keywords_lines[0]:
                try:
                    self.stdscr.addnstr(top, 3, "(no keywords)", width - 6, self.pair("muted"))
                except curses.error:
                    pass

    def draw_output(self, top, width):
        items = [
            (self.copy_to_clipboard, "Copy transcription to clipboard"),
            (self.pause_media, "Pause other media while recording"),
        ]
        for i, (checked, label) in enumerate(items):
            cursor = ">" if i == self.out_idx else " "
            box = "[x]" if checked else "[ ]"
            text = f" {cursor} {box} {label}"
            pair = self.pair("sel") if i == self.out_idx else self.pair("fg")
            try:
                self.stdscr.addnstr(top + i, 3, text, width - 6, pair)
            except curses.error:
                pass


def run(stdscr, name, preset):
    stdscr.keypad(True)
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    pairs = setup_colors(theme_colors())
    editor = Editor(stdscr, name, preset, pairs)
    if not name:
        ok, value = editor.input_line("Preset name", "")
        if not ok:
            return
        editor.name = value
    editor.run()


def main():
    if len(sys.argv) > 1:
        name = sys.argv[1]
    else:
        name = ""
    data = load()
    preset = next((p for p in data["presets"] if p.get("name") == name), None)
    if name and preset is None:
        print(f"no preset named {name!r}")
        return 1
    curses.wrapper(run, name, preset)
    return 0


if __name__ == "__main__":
    sys.exit(main())
