#!/usr/bin/env python3
"""omarchy-voxtype-presets — cycle, apply, and watch Voxtype presets.

A preset is a name + model + language + keyword prompt + media-pause setting.
The built-in default is seeded from the existing Voxtype configuration and
cannot be removed.

  name     -> preset identifier
  model    -> [whisper] model
  language -> [whisper] language

Storage:
  ~/.config/voxtype/presets.json        presets + active name (edited by the TUI)
  ~/.config/voxtype/presets-state.json  one-line JSON written on apply, streamed by `watch`

Applying a preset patches ~/.config/voxtype/config.toml in place (comments and
unrelated keys are preserved), backs the file up, and restarts the user
voxtype systemd daemon — the only reload path voxtype currently supports.

Commands:
  list               print presets.json
  state              print the current state line
  cycle              apply the next preset after the active one
  apply <name>       apply a specific preset
  watch              stream the state line, reprinting whenever it changes
  seed               create presets.json with the default English preset
  migrate            normalize preset fields, preserving keyword/media overrides
"""

import copy
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from voxtype_presets_lib import config_defaults, ensure_model, load, save  # noqa: E402

HOME = Path.home()
CONFIG = Path(os.environ.get("VOXTYPE_CONFIG", str(HOME / ".config/voxtype/config.toml")))
PRESETS = HOME / ".config/voxtype/presets.json"
STATE = HOME / ".config/voxtype/presets-state.json"

EMPTY_STATE = {"name": "", "model": "", "language": ""}


def bool_value(value, default=True):
    if isinstance(value, bool):
        return value
    if value is None:
        return default
    return str(value).strip().lower() not in {"false", "0", "no", "off"}


def is_default_preset(preset):
    return bool(preset.get("default")) or (
        preset.get("name") == "english" and
        preset.get("model") == "base.en" and
        preset.get("language") == "en")


def find_preset(data, name):
    for preset in data.get("presets", []):
        if preset.get("name") == name:
            return preset
    return None


def state_json():
    if STATE.exists():
        try:
            state = json.loads(STATE.read_text())
            return {"name": str(state.get("name", "")),
                    "model": str(state.get("model", "")),
                    "language": str(state.get("language", ""))}
        except Exception:
            pass
    return dict(EMPTY_STATE)


# --- config.toml patching -------------------------------------------------

def read_key(text, section, key):
    """Read a key from a TOML section block, returning None when absent."""
    lines = text.split("\n")
    header = f"[{section}]"
    inside = False
    pattern = re.compile(rf"^\s*{re.escape(key)}\s*=\s*(.*)$")
    for line in lines:
        stripped = line.strip()
        if stripped == header:
            inside = True
            continue
        if inside and stripped.startswith("["):
            break
        if inside:
            match = pattern.match(line)
            if match:
                return match.group(1).strip()
    return None


def toml_value(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    return json.dumps(str(value), ensure_ascii=False)


def patch_toml(text, section, key, value):
    """Replace or insert `key = value` inside [section], preserving everything else."""
    lines = text.split("\n")
    header = f"[{section}]"
    start = end = None
    for i, line in enumerate(lines):
        if line.strip() == header:
            start = i
        elif start is not None and line.strip().startswith("["):
            end = i
            break
    if start is None:
        lines += ["", header, f"{key} = {value}"]
        return "\n".join(lines)
    if end is None:
        end = len(lines)
    pattern = re.compile(rf"^(\s*){re.escape(key)}\s*=.*$")
    for i in range(start + 1, end):
        match = pattern.match(lines[i])
        if match:
            lines[i] = f"{match.group(1)}{key} = {value}"
            return "\n".join(lines)
    lines.insert(start + 1, f"{key} = {value}")
    return "\n".join(lines)


# --- applying ---------------------------------------------------------------

def apply_preset(data, preset):
    name = preset.get("name", "")
    model = str(preset.get("model", "")).strip()
    language = str(preset.get("language", "auto")).strip() or "auto"
    keywords = str(preset.get("keywords", "")).strip()
    pause_media = bool_value(preset.get("pauseMedia"), True)

    if not model:
        print(f"preset {name!r} has no model", file=sys.stderr)
        return 1

    # Fetch the model first when it is missing; instant no-op when present.
    print(f"checking model {model}…", file=sys.stderr)
    ok, err = ensure_model(model)
    if not ok:
        print(f"model {model!r} download failed: {err}", file=sys.stderr)
        return 1

    before_data = copy.deepcopy(data)
    before_config = CONFIG.read_text() if CONFIG.exists() else None
    before_state = STATE.read_text() if STATE.exists() else None

    text = before_config or ""
    text = patch_toml(text, "whisper", "model", toml_value(model))
    text = patch_toml(text, "whisper", "language", toml_value(language))
    prompt = f"Use these terms exactly when dictated: {keywords}" if keywords else ""
    text = patch_toml(text, "whisper", "initial_prompt", toml_value(prompt))
    text = patch_toml(text, "audio", "pause_media", toml_value(pause_media))

    if CONFIG.exists():
        backup = CONFIG.with_name(CONFIG.name + f".bak.{int(time.time())}")
        backup.write_text(CONFIG.read_text())

    CONFIG.write_text(text)

    def rollback(reason):
        if before_config is None:
            CONFIG.unlink(missing_ok=True)
        else:
            CONFIG.write_text(before_config)
        save(before_data)
        if before_state is None:
            STATE.unlink(missing_ok=True)
        else:
            STATE.write_text(before_state)
        restored = subprocess.run(["systemctl", "--user", "restart", "voxtype"],
                                  check=False)
        if restored.returncode != 0:
            print("also failed to restore the previous voxtype configuration",
                  file=sys.stderr)
        print(reason, file=sys.stderr)
        return 1

    restart = subprocess.run(["systemctl", "--user", "restart", "voxtype"],
                             check=False)
    if restart.returncode != 0:
        return rollback("failed to restart voxtype.service")
    active = subprocess.run(["systemctl", "--user", "is-active", "--quiet",
                             "voxtype"], check=False)
    if active.returncode != 0:
        return rollback("voxtype.service is not active after applying preset")

    data["active"] = name
    save(data)
    STATE.write_text(json.dumps({"name": name, "model": model, "language": language}, ensure_ascii=False) + "\n")
    subprocess.run(
        ["notify-send", "-a", "Voxtype",
         f"Voxtype preset: {name}",
         f"{model} · {language}"],
        check=False,
    )
    print(f"applied {name}: model={model} language={language}")
    return 0


def cmd_list():
    print(json.dumps(load(), ensure_ascii=False))


def cmd_state():
    print(json.dumps(state_json(), ensure_ascii=False), flush=True)


def cmd_cycle():
    data = load()
    presets = data.get("presets", [])
    if not presets:
        print("no presets defined", file=sys.stderr)
        return 1
    active = data.get("active", "")
    index = 0
    for i, preset in enumerate(presets):
        if preset.get("name") == active:
            index = i
            break
    next_preset = presets[(index + 1) % len(presets)]
    return apply_preset(data, next_preset)


def cmd_apply(name):
    data = load()
    preset = find_preset(data, name)
    if preset is None:
        print(f"no preset named {name!r}", file=sys.stderr)
        return 1
    return apply_preset(data, preset)


def cmd_watch():
    if not load().get("presets"):
        cmd_seed()
    last = None
    while True:
        current = state_json()
        if current != last:
            print(json.dumps(current, ensure_ascii=False), flush=True)
            last = current
        time.sleep(1)


def cmd_seed():
    if PRESETS.exists():
        print(f"presets already exist at {PRESETS}")
        return 0
    text = CONFIG.read_text() if CONFIG.exists() else ""

    def cfg(section, key, default):
        value = read_key(text, section, key)
        if value is None:
            return default
        value = value.strip()
        if value.startswith('"') and value.endswith('"'):
            value = value[1:-1]
        return value

    model = cfg("whisper", "model", "base.en")
    language = cfg("whisper", "language", "en")
    keywords, pause_media = config_defaults()

    data = {
        "active": "english",
        "presets": [
            {
                "name": "english",
                "model": model,
                "language": language,
                "keywords": keywords,
                "pauseMedia": pause_media,
                "default": True,
            },
        ],
    }
    save(data)
    STATE.write_text(json.dumps({"name": "english", "model": model, "language": language}, ensure_ascii=False) + "\n")
    print(f"seeded presets at {PRESETS} (english default)")


def cmd_migrate():
    """Normalize preset fields while preserving keyword/media overrides."""
    data = load()
    migrated = []
    active = data.get("active", "")
    default_keywords, default_pause_media = config_defaults()

    def unique_name(name):
        candidate = name or "preset"
        if not any(p.get("name") == candidate for p in migrated):
            return candidate
        suffix = 2
        while any(p.get("name") == f"{candidate}-{suffix}" for p in migrated):
            suffix += 1
        return f"{candidate}-{suffix}"

    for preset in data.get("presets", []):
        entry = {
            "name": unique_name(str(preset.get("name", ""))),
            "model": str(preset.get("model", "")).strip() or "base.en",
            "language": str(preset.get("language", "auto")).strip() or "auto",
            "keywords": (str(preset["keywords"]).strip()
                         if "keywords" in preset else default_keywords),
            "pauseMedia": bool_value(preset.get("pauseMedia"), default_pause_media),
        }
        if any(p.get("model") == entry["model"] and
               p.get("language") == entry["language"] for p in migrated):
            if active == preset.get("name"):
                active = next(p["name"] for p in migrated
                              if p.get("model") == entry["model"] and
                              p.get("language") == entry["language"])
            continue
        if bool(preset.get("default")) or (
                entry["name"] == "english" and entry["model"] == "base.en" and
                entry["language"] == "en"):
            entry["default"] = True
        migrated.append(entry)
    if not any(p.get("default") for p in migrated):
        name = unique_name("english")
        migrated.insert(0, {"name": name, "model": "base.en",
                            "language": "en", "keywords": default_keywords,
                            "pauseMedia": default_pause_media, "default": True})
        if not active:
            active = name
    data["presets"] = migrated
    data["active"] = active
    save(data)
    print(json.dumps(data, ensure_ascii=False))


def main():
    if len(sys.argv) < 2:
        print(__doc__.strip(), file=sys.stderr)
        return 1
    command = sys.argv[1]
    if command == "list":
        return cmd_list()
    if command == "state":
        return cmd_state()
    if command == "cycle":
        return cmd_cycle()
    if command == "apply" and len(sys.argv) >= 3:
        return cmd_apply(sys.argv[2])
    if command == "watch":
        return cmd_watch()
    if command == "seed":
        return cmd_seed()
    if command == "migrate":
        return cmd_migrate()
    print(f"unknown command {command!r}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
